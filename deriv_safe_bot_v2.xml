<xml xmlns="http://www.w3.org/1999/xhtml" is_dbot="true" collection="false">
  <variables>
    <variable id="vLossStreak">loss_streak</variable>
    <variable id="vTrades">trades_done</variable>
  </variables>
  <block type="trade_definition" id="tradeDef" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="tdMarket" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ100V</field>
        <next>
          <block type="trade_definition_tradetype" id="tdType" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">callput</field>
            <field name="TRADETYPE_LIST">callput</field>
            <next>
              <block type="trade_definition_contracttype" id="tdContract" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="tdCandle" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="tdRestartBS" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="tdRestartErr" deletable="false" movable="false">
                            <field name="RESTARTONERROR">FALSE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="initLoss">
        <field name="VAR" id="vLossStreak">loss_streak</field>
        <value name="VALUE"><block type="math_number" id="n0a"><field name="NUM">0</field></block></value>
        <next>
          <block type="variables_set" id="initTrades">
            <field name="VAR" id="vTrades">trades_done</field>
            <value name="VALUE"><block type="math_number" id="n0b"><field name="NUM">0</field></block></value>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="tdOptions">
        <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number" id="durShadow"><field name="NUM">5</field></shadow>
          <block type="math_number" id="durNum"><field name="NUM">5</field></block>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="stakeShadow"><field name="NUM">1</field></shadow>
          <block type="math_number" id="stakeNum"><field name="NUM">1</field></block>
        </value>
      </block>
    </statement>
  </block>

  <!-- 2. Follow the last 1-minute candle: Rise if it closed up, Fall otherwise -->
  <block type="before_purchase" id="beforePurchase" deletable="false" x="0" y="620">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="dirIf">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="check_direction" id="dirRise"><field name="CHECK_DIRECTION">rise</field></block>
        </value>
        <statement name="DO0">
          <block type="purchase" id="buyRise"><field name="PURCHASE_LIST">CALL</field></block>
        </statement>
        <statement name="ELSE">
          <block type="purchase" id="buyFall"><field name="PURCHASE_LIST">PUT</field></block>
        </statement>
      </block>
    </statement>
  </block>

  <block type="during_purchase" id="duringPurchase" deletable="false" x="640" y="0"></block>

  <!-- 4. Count trades and losses in a row, then decide whether to continue -->
  <block type="after_purchase" id="afterPurchase" deletable="false" x="640" y="160">
    <statement name="AFTERPURCHASE_STACK">
      <block type="math_change" id="countTrade">
        <field name="VAR" id="vTrades">trades_done</field>
        <value name="DELTA"><block type="math_number" id="n1a"><field name="NUM">1</field></block></value>
        <next>
          <block type="controls_if" id="winIf">
            <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
            <value name="IF0">
              <block type="contract_check_result" id="isWin"><field name="CHECK_RESULT">win</field></block>
            </value>
            <statement name="DO0">
              <block type="variables_set" id="resetLoss">
                <field name="VAR" id="vLossStreak">loss_streak</field>
                <value name="VALUE"><block type="math_number" id="n0c"><field name="NUM">0</field></block></value>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="math_change" id="addLoss">
                <field name="VAR" id="vLossStreak">loss_streak</field>
                <value name="DELTA"><block type="math_number" id="n1b"><field name="NUM">1</field></block></value>
              </block>
            </statement>
            <next>
              <block type="controls_if" id="continueIf">
                <value name="IF0">
                  <block type="logic_operation" id="and1">
                    <field name="OP">AND</field>
                    <value name="A">
                      <block type="logic_operation" id="and2">
                        <field name="OP">AND</field>
                        <value name="A">
                          <block type="logic_compare" id="lossLimit">
                            <field name="OP">GT</field>
                            <value name="A"><block type="total_profit" id="tp1"></block></value>
                            <value name="B"><block type="math_number" id="nLoss"><field name="NUM">-3</field></block></value>
                          </block>
                        </value>
                        <value name="B">
                          <block type="logic_compare" id="profitTarget">
                            <field name="OP">LT</field>
                            <value name="A"><block type="total_profit" id="tp2"></block></value>
                            <value name="B"><block type="math_number" id="nProfit"><field name="NUM">2</field></block></value>
                          </block>
                        </value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="logic_operation" id="and3">
                        <field name="OP">AND</field>
                        <value name="A">
                          <block type="logic_compare" id="streakLimit">
                            <field name="OP">LT</field>
                            <value name="A"><block type="variables_get" id="getLoss"><field name="VAR" id="vLossStreak">loss_streak</field></block></value>
                            <value name="B"><block type="math_number" id="nStreak"><field name="NUM">3</field></block></value>
                          </block>
                        </value>
                        <value name="B">
                          <block type="logic_compare" id="tradeLimit">
                            <field name="OP">LT</field>
                            <value name="A"><block type="variables_get" id="getTrades"><field name="VAR" id="vTrades">trades_done</field></block></value>
                            <value name="B"><block type="math_number" id="nTrades"><field name="NUM">20</field></block></value>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="trade_again" id="tradeAgain"></block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
